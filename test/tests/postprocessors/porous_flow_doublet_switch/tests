[Tests]
  design = 'PorousFlowDoubletSwitch.md'
  issues = '#147 #178'

  [doublet_switch]
    type = CSVDiff
    input = 'inp.i'
    csvdiff = 'inp_out.csv'
    abs_zero = 1.0e-08
    requirement = "The system shall report a 0/1 daily duty-cycle indicator, active for a "
                  "configurable fraction of each day once a temperature-tolerance breakthrough "
                  "criterion has latched, matching a hand-derived analytic solution to within "
                  "floating-point tolerance."
  []

  [doublet_switch_latch_at_zero]
    type = CSVDiff
    input = 'inp.i'
    csvdiff = 'switch_latch_at_zero_out.csv'
    abs_zero = 1.0e-08
    cli_args = "Functions/target_fn/expression='10' "
               "Functions/exact_fn/expression='if(t/86400 - floor(t/86400) < 0.5, 1, 0)' "
               "Postprocessors/cur_time/execute_on='initial timestep_end' "
               "Postprocessors/target/execute_on='initial timestep_end' "
               "Postprocessors/computed/execute_on='initial timestep_end' "
               "Postprocessors/exact/execute_on='initial timestep_end' "
               "Postprocessors/residual/execute_on='initial timestep_end' "
               "Outputs/file_base=switch_latch_at_zero_out"
    requirement = 'The system shall run a doublet duty cycle from a charge time that latches at '
                  't = 0, where the latched charge time coincides with the not-yet-latched '
                  'sentinel, rather than re-latching it on every subsequent timestep and '
                  'restarting the duty cycle. This requires a separate triggered flag.'
  []
[]
