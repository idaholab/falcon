[Tests]
  design = 'PorousFlowRecoveryTimeAccumulator.md'
  issues = '#147 #178'

  [recovery_time_accumulator]
    type = CSVDiff
    input = 'inp.i'
    csvdiff = 'inp_out.csv'
    abs_zero = 1.0e-08
    requirement = "The system shall accumulate elapsed operating time, in days, while an "
                  "indicator postprocessor is truthy, matching a hand-derived analytic solution "
                  "to within floating-point tolerance."
  []

  [recovery_time_accumulator_tiny_indicator]
    type = CSVDiff
    input = 'inp.i'
    csvdiff = 'inp_out.csv'
    abs_zero = 1.0e-08
    prereq = 'recovery_time_accumulator'
    ignore_columns = 'indicator'
    # 0.0000001 rather than 1e-16: the ParsedFunction silently evaluates a 1e-16 literal to
    # exactly 0, which would make this probe inert -- an implicit nonzero test would then agree
    # with the thresholded one and the test could not fail.
    cli_args = "Functions/indicator_fn/expression='if(t <= 345600, 1, 0.0000001)'"
    requirement = 'The system shall stop accumulating recovery time once the indicator falls to a '
                  'small but nonzero value, as a smoothed or transfer-round-tripped '
                  'indicator would, reproducing the same total as a bit-exact 0. An implicit '
                  'nonzero test keeps accumulating here and fails.'
  []
[]
