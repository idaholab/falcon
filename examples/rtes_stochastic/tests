# All of the RTES example tests below are pinned to exactly 4 MPI ranks. IterationAdaptiveDT's
# accepted step-size trajectory depends on the per-rank nonlinear convergence history, so these
# CSV golds are not rank-count invariant; the bound is pinned rather than ranged for that reason.
#
# Caveat, established against CIVET rather than this repository (no CI recipe is checked in here):
# as of PR #178, none of the five PR-attached CIVET jobs runs --heavy at all, and the highest rank
# count any of them uses is 2 -- the Test recipe's steps are "Test falcon", "Test falcon -p 2",
# "Test falcon --n-threads=2" and "Test falcon dbg", and the Apptainer, Coverage, Documentation and
# Precheck jobs run no test sweep of their own. These seven tests therefore do not execute in PR
# CI, both for want of --heavy and because 4 > 2, so a green PR CI says nothing about them either
# way. Whether a separate scheduled/nightly recipe runs them at 4 ranks is not visible from a PR
# job list. If no heavy runner supplies 4 ranks, the bound should be dropped and these golds
# regenerated at a rank count that is actually exercised. Tracked separately.

[Tests]
  issues = '#178'
  design = 'examples/rtes_stochastic.md'
  max_time = 1800 # stochastic MultiApp; heavy test

  [base_cycle]
    type = CSVDiff
    input = 'base_cycle_50.i'
    csvdiff = 'base_cycle_50_CSV.csv'
    cli_args = '--allow-unused Executioner/num_steps=20'
    capabilities = 'method!=dbg'
    heavy = true
    min_parallel = 4 # see the rank-count note at the top of this file
    max_parallel = 4
    # recover is disabled: the trajectory is rank-count dependent (see max_parallel
    # comment above) and, until this PR, several postprocessors used in the sweep
    # (accumulators/latches) held non-restartable state that would silently reset on
    # --recover. That state is now declared restartable, but recover=true has not been
    # verified end-to-end for this heavy example, so it stays disabled here.
    recover = false
    requirement = 'The system shall run the single-realization generic doublet RTES physics '
                  'model (base_cycle_50.i, on base_final_50_blockid_fix.e) standalone, for a '
                  'bounded number of timesteps (not the full 10 year transient), and '
                  'reproduce a self-baseline gold. This is a generic, parametrically-swept '
                  'caprock-reservoir-bedrock formation (not the site-specific Cranfield '
                  'geology), so no site-specific TOUGH reference dataset applies here; no '
                  'TOUGH comparison is attempted for this example, only a self-baseline '
                  'regression. The --allow-unused flag suppresses an unused-parameter error '
                  'for the unreferenced aquifer_top command-line variable already present in '
                  'the input. base_final_50_blockid_fix.e is a copy of base_final_50.e whose '
                  'element-block IDs were renumbered to fit the unsigned-short block-ID field '
                  'read by the current libMesh ExodusII_IO reader; block, nodeset and sideset '
                  'names -- which is how this input references them -- are unchanged. The '
                  'original base_final_50.e is not present on this branch or on devel, so the '
                  'renumbering is not independently auditable from the revision history; the '
                  'renumbered file\'s own embedded NetCDF metadata is the audit trail instead, '
                  'recording a Cubit-written title naming base_final_50.e and eb_prop1/eb_names '
                  'of caps_HEX8=1, caps_WEDGE=3, aquifer_HEX8=2, aquifer_WEDGE=4. See the '
                  '[Mesh] comment in base_cycle_50.i.'
  []

  [master_cycle]
    type = CSVDiff
    input = 'master_cycle_50.i'
    csvdiff = 'master_cycle_50_out_results_0001.csv master_cycle_50_out_runner0_CSV.csv '
              'master_cycle_50_out_runner1_CSV.csv'
    cli_args = "--allow-unused Samplers/montecarlo/num_rows=2 "
               "MultiApps/runner/cli_args='Executioner/error_on_dtmin=false;"
               "Executioner/num_steps=10'"
    capabilities = 'method!=dbg'
    heavy = true
    min_parallel = 4 # see the rank-count note at the top of this file
    max_parallel = 4
    # recover is disabled: the trajectory is rank-count dependent (see max_parallel
    # comment above) and, until this PR, several postprocessors used in the sweep
    # (accumulators/latches) held non-restartable state that would silently reset on
    # --recover. That state is now declared restartable, but recover=true has not been
    # verified end-to-end for this heavy example, so it stays disabled here.
    recover = false
    requirement = 'The system shall run the StochasticTools master (master_cycle_50.i), '
                  'which drives base_cycle_50.i as a SamplerFullSolveMultiApp sub-application '
                  'in batch-reset mode, for a bounded number of Monte Carlo samples '
                  '(num_rows overridden from the production default of 50000 down to 2) and '
                  'a bounded number of sub-application timesteps, and reproduce a '
                  'self-baseline gold of the per-sample results and the aggregated '
                  'StochasticResults vector postprocessor. As with base_cycle above, this is '
                  'a generic parametric sweep, not the site-specific Cranfield geology, so '
                  'no TOUGH comparison is attempted.'
  []
[]
