[Tests]
  issues = '#178'
  design = 'examples/rtes_htm.md'

  [continuous]
    type = CSVDiff
    input = 'Cranfield_HTM_continous_season_caps_water_newboundary_coarse.i'
    csvdiff = 'Cranfield_HTM_continous_season_caps_water_newboundary_coarse_CSV.csv'
    cli_args = 'Executioner/num_steps=10'
    capabilities = 'method!=dbg'
    heavy = true
    min_parallel = 4 # heavy RTES example: skipped unless run with >=4 MPI ranks
    max_parallel = 4 # gold is generated at 4 ranks (IterationAdaptiveDT trajectory is rank-count dependent)
    # recover is disabled: the trajectory is rank-count dependent (see max_parallel
    # comment above) and, until this PR, several postprocessors used in the sweep
    # (accumulators/latches) held non-restartable state that would silently reset on
    # --recover. That state is now declared restartable, but recover=true has not been
    # verified end-to-end for this heavy example, so it stays disabled here.
    recover = false
    max_time = 1800 # HTM coupled-mechanics steps are ~44s each; bounded heavy test
    requirement = 'The system shall run the hydro-thermo-mechanical (HTM) coupled Cranfield '
                  'RTES benchmark with a continuous seasonal injection schedule, on '
                  'Cranfield_caps_new_coarse.e, for a bounded number of timesteps (not the '
                  'full 10 year transient) and reproduce a self-baseline gold.'
  []

  [pushpull]
    type = CSVDiff
    input = 'Cranfield_HTM_push-pull_season_caps_water_newboundary_coarse.i'
    csvdiff = 'Cranfield_HTM_push-pull_season_caps_water_newboundary_coarse_CSV.csv'
    cli_args = 'Executioner/num_steps=10'
    capabilities = 'method!=dbg'
    heavy = true
    min_parallel = 4 # heavy RTES example: skipped unless run with >=4 MPI ranks
    max_parallel = 4 # gold is generated at 4 ranks (IterationAdaptiveDT trajectory is rank-count dependent)
    # recover is disabled: the trajectory is rank-count dependent (see max_parallel
    # comment above) and, until this PR, several postprocessors used in the sweep
    # (accumulators/latches) held non-restartable state that would silently reset on
    # --recover. That state is now declared restartable, but recover=true has not been
    # verified end-to-end for this heavy example, so it stays disabled here.
    recover = false
    max_time = 1800 # HTM coupled-mechanics steps are ~44s each; bounded heavy test
    requirement = 'The system shall run the HTM-coupled Cranfield RTES benchmark with a '
                  'push-pull (summer inject / winter extract / rest) seasonal schedule, on '
                  'Cranfield_caps_new_coarse.e, for a bounded number of timesteps and '
                  'reproduce a self-baseline gold.'
  []
[]
